# Workbench login (required when deployed). Session secret: at least 32 random characters, e.g. `openssl rand -hex 32`.
WORKBENCH_PASSWORD=
WORKBENCH_SESSION_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
CREDENTIAL_ADMIN_TOKEN=
OBSIDIAN_VAULT_DIR=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=
CODEX_LOCAL_BASE_URL=
CODEX_LOCAL_MODEL=openai/gpt-4o-mini
CODEX_LOCAL_API_KEY=
OPENCLAW_GATEWAY_URL=
LLM_NO_KEY_MODE=
OPENROUTER_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Claude: plans goals, reviews results and powers /console. Model defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Or use the owner's logged-in Claude Code on the VPS instead of an API key (see docs/claude-bridge.md).
CLAUDE_BRIDGE_URL=
CLAUDE_BRIDGE_TOKEN=
CLAUDE_BRIDGE_CA=
ZLINK_MCP_TOKEN=
# Shared with ~/claude-bridge/bridge.env: signs one-time passes to the CloudCLI gate.
CLI_GATE_SECRET=
# Optional manual CloudCLI address for the console (default http://localhost:3001 via SSH tunnel; later https://cli.<domain>).
NEXT_PUBLIC_CLOUDCLI_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VERTEX_MODE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
KIMI_API_KEY=
N8N_WEBHOOK_URL=
N8N_SOCIAL_WEBHOOK_URL=
N8N_TOOL_CONNECTION_ID=
N8N_OUTBOUND_SECRET=
N8N_CALLBACK_SECRET=
CONTENT_SCHEDULER_TOKEN=
CONTENT_ADMIN_TOKEN=
CONTENT_TIMEZONE=Asia/Shanghai
DEMO_OWNER_ID=
USE_LOCAL_STORE=false
